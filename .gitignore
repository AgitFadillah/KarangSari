# =============================================================================
#  .gitignore untuk repositori Website Desa KarangSari
# =============================================================================
#  Repositori ini berisi dua bagian:
#    1. Prototipe desain statis di akar repositori (index.html, admin/, css/, js/)
#    2. Aplikasi Laravel di folder backend/
#
#  Aturan di berkas ini berlaku untuk SELURUH repositori. Aturan tambahan
#  khusus aplikasi Laravel ada di backend/.gitignore.
#
#  Yang TIDAK boleh masuk repositori:
#    - .env (berisi kata sandi basis data, APP_KEY, kredensial S3)
#    - vendor/ dan node_modules/ (dipasang ulang saat deploy, ~145 MB)
#    - database/database.sqlite (berisi data warga sungguhan di komputer dev)
#    - storage/ (dokumen KTP/KK warga, log)
#    - berkas coretan pengujian di akar repositori
# =============================================================================

# -----------------------------------------------------------------------------
# Rahasia & konfigurasi lingkungan
# -----------------------------------------------------------------------------
# .env berisi APP_KEY, kata sandi basis data, dan kredensial penyimpanan.
# Bila berkas ini ikut ter-commit, siapa pun yang bisa membaca repo dapat
# membuka basis data produksi dan memalsukan cookie sesi admin.
.env
.env.*
!.env.example
!.env.production.example

# Kunci enkripsi & sertifikat
*.key
*.pem
*.p12
*.pfx

# -----------------------------------------------------------------------------
# Dependensi (dipasang ulang oleh server saat deploy)
# -----------------------------------------------------------------------------
vendor/
node_modules/
composer.phar
/auth.json

# -----------------------------------------------------------------------------
# Hasil build frontend
# -----------------------------------------------------------------------------
# Vite menulis ke public/build. Berkas ini dihasilkan oleh "npm run build",
# jadi tidak perlu disimpan — tetapi server WAJIB menjalankan build tersebut.
/public/build
/public/hot
/public/fonts-manifest.dev.json

# -----------------------------------------------------------------------------
# Berkas yang dihasilkan saat aplikasi berjalan
# -----------------------------------------------------------------------------
# Dokumen warga (KTP/KK/foto usaha) dan log TIDAK boleh masuk repositori.
/storage/*.key
/storage/pail
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/app/private/*
/storage/app/public/perangkat/*
!/storage/app/private/.gitignore
!/storage/app/public/.gitignore
/bootstrap/cache/*.php
/public/storage

# Basis data SQLite lokal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# -----------------------------------------------------------------------------
# Berkas sementara & coretan pengujian
# -----------------------------------------------------------------------------
# Berkas coretan di akar repositori (keluaran skrip uji manual) tidak
# termasuk bagian aplikasi.
/t-*.txt
/test-*.txt
/test-out*.txt
/tmp_*.php
/err*.html
/cookies*.txt

# -----------------------------------------------------------------------------
# Editor & sistem operasi
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.nova/
.phpunit.result.cache
.phpunit.cache/
_ide_helper.php

# -----------------------------------------------------------------------------
# Dokumen internal desa
# -----------------------------------------------------------------------------
# Folder docs/ berisi dokumen Word asli dari perangkat desa (profil desa,
# template surat resmi, kop surat). Isinya bukan bagian dari kode aplikasi dan
# tidak dipublikasikan di repositori ini. Salin sendiri bila ingin menjalankan
# migrasi/seed yang menyebut nama berkasnya (hanya sebagai label).
/docs/
