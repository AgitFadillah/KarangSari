APP_NAME=KarangSari
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Percayai header X-Forwarded-* HANYA bila situs berada di belakang reverse
# proxy / load balancer / Cloudflare (Railway, Render, dll).
#
# Tanpa nilai ini, aplikasi membaca IP proxy — bukan IP warga — sehingga
# rate limit per-IP dan deteksi HTTPS (cookie Secure) menjadi salah.
#   Railway / Render / Fly.io  ->  TRUSTED_PROXIES=*
#   Cloudflare                 ->  daftar CIDR Cloudflare
#   Server diakses langsung    ->  biarkan kosong
TRUSTED_PROXIES=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Zona waktu aplikasi. Seluruh halaman menampilkan jam dengan akhiran "WIB",
# dan tanggal surat diambil dari sini. Bila dibiarkan UTC, jam yang dilihat
# warga akan berselisih 7 jam dari jam sebenarnya.
#   WIB -> Asia/Jakarta    WITA -> Asia/Makassar    WIT -> Asia/Jayapura
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Basis data
# ---------------------------------------------------------------------------
# Produksi WAJIB PostgreSQL atau MySQL. SQLite tidak cocok untuk produksi:
# beberapa warga yang mengirim bersamaan dapat membuat berkas terkunci.
#
#   Lokal (paling cepat)  ->  DB_CONNECTION=sqlite
#   Railway / Supabase    ->  DB_CONNECTION=pgsql
#   cPanel / VPS          ->  DB_CONNECTION=mysql
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=karangsari
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=require

# Kata sandi akun admin awal (minimal 12 karakter). Dipakai HANYA saat
# db:seed. Bila dikosongkan, seeder membuatkan sandi acak dan menampilkannya
# sekali di konsol — catat saat itu, karena tidak bisa dilihat lagi.
ADMIN_SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Identitas desa
# ---------------------------------------------------------------------------
# Nilai di bawah hanya dipakai sebagai nilai AWAL saat seeder dijalankan dan
# sebagai cadangan bila tabel profil_desas belum siap. Setelah instalasi,
# ubah identitas desa lewat menu "Profil & Kontak" di dashboard admin.
DESA_NAMA="Desa Karang Sari"
DESA_KECAMATAN="Jati Agung"
DESA_KABUPATEN="Lampung Selatan"
DESA_PROVINSI="Lampung"
DESA_ALAMAT_KANTOR=
DESA_KODE_POS=35365
DESA_TAHUN_BERDIRI=

# Awalan nomor referensi pengajuan, mis. KRS -> KRS-2026-0001.
DESA_PREFIX_REFERENSI=KRS

# Awalan kode surat pada pratinjau surat, mis. DS-KRS/____/DS-KRS/2026.
DESA_KODE_SURAT=DS-KRS

# Kode wilayah pada nomor surat resmi, mis. 470/  /18.01.13.2019/XI/2026.
DESA_KODE_WILAYAH_SURAT=18.01.13.2019

# Versi pemberitahuan data yang disetujui warga (bukti persetujuan UU PDP).
DESA_VERSI_PEMBERITAHUAN_DATA=2026-01

# ---------------------------------------------------------------------------
# Sesi
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# WAJIB true bila situs sudah HTTPS. Tanpa ini, cookie sesi admin ikut
# terkirim lewat koneksi HTTP biasa dan bisa dicuri di Wi-Fi publik.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# Penyimpanan berkas
# ---------------------------------------------------------------------------
# Dokumen warga (KTP/KK/foto usaha) HARUS di disk privat — jangan "public".
#
#   DOKUMEN_DISK=local  -> storage/app/private di server (default)
#   DOKUMEN_DISK=s3     -> bucket privat Supabase Storage / S3
#
# PENTING untuk Railway/Render/Fly.io: sistem berkas container bersifat
# SEMENTARA dan hilang setiap deploy ulang. Pasang volume persisten pada
# storage/, atau pakai DOKUMEN_DISK=s3 agar dokumen warga tidak hilang.
FILESYSTEM_DISK=local
DOKUMEN_DISK=local

# Hanya dipakai bila DOKUMEN_DISK=s3 (bucket privat).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=dokumen-warga
# AWS_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# AWS_USE_PATH_STYLE_ENDPOINT=true

# ---------------------------------------------------------------------------
# Email — MAIL_MAILER=log berarti email TIDAK pernah terkirim
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@karangsari.desa.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
