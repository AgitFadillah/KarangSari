# =============================================================================
#  Situs Desa KarangSari — contoh konfigurasi PRODUCTION
# =============================================================================
#  Cara pakai:
#    1. Salin file ini menjadi ".env" di server  ->  cp .env.production.example .env
#    2. Isi semua nilai bertanda  <<< ISI >>>  dan  <<< RAHASIA >>>
#    3. php artisan key:generate        (SEKALI saja, saat instalasi baru)
#    4. php artisan migrate --force
#    5. php artisan db:seed --force     (SEKALI saja, saat instalasi baru)
#    6. php artisan config:cache && php artisan route:cache && php artisan view:cache
#
#  PENTING: file .env JANGAN pernah dimasukkan ke repositori atau dibagikan.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplikasi  — bagian PALING menentukan keamanan
# -----------------------------------------------------------------------------
APP_NAME="Desa KarangSari"
APP_ENV=production
APP_KEY=

# WAJIB false. Bila true, satu error akan menampilkan stack trace, isi .env,
# dan potongan kode ke pengunjung mana pun.
APP_DEBUG=false

# Harus https:// dan tanpa garis miring di akhir.
APP_URL=https://karangsari.desa.id

# Isi HANYA bila situs di belakang reverse proxy/Cloudflare/load balancer.
# Contoh: TRUSTED_PROXIES=103.21.244.0/22,172.70.0.0/16
# Nilai "*" boleh dipakai bila seluruh trafik memang selalu lewat proxy
# tepercaya. Kosongkan bila server diakses langsung.
TRUSTED_PROXIES=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Zona waktu aplikasi. Seluruh halaman menampilkan jam berakhiran "WIB" dan
# tanggal surat diambil dari sini. Bila dibiarkan UTC (bawaan Laravel), jam
# yang dilihat warga berselisih 7 jam dari jam sebenarnya.
#   WIB -> Asia/Jakarta    WITA -> Asia/Makassar    WIT -> Asia/Jayapura
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Log
# -----------------------------------------------------------------------------
# debug = sangat banyak. Di produksi pakai error atau warning.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Basis data
# -----------------------------------------------------------------------------
# OPSI A — Supabase (Postgres). Ambil nilai dari Supabase > Project Settings >
# Database > Connection pooling > "Session mode" atau "Transaction mode".
#   DB_HOST     = aws-0-<region>.pooler.supabase.com
#   DB_PORT     = 5432 (session) atau 6543 (transaction)
#   DB_DATABASE = postgres
#   DB_USERNAME = postgres.<project-ref>
#   DB_PASSWORD = kata sandi database project (bukan token sbp_/anon key)
# Wajib DB_SSLMODE=require: koneksi Supabase melewati internet publik.
#
# OPSI B — MySQL di server sendiri (cPanel/VPS). Ganti DB_CONNECTION=mysql,
# port 3306, dan isi host/user/password lokal.
#
# SQLite TIDAK cocok untuk produksi: beberapa warga mengirim bersamaan dapat
# membuat berkas SQLite terkunci atau rusak.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<<< PROJECT-REF >>>
DB_PASSWORD=<<< RAHASIA >>>
DB_SSLMODE=require

# -----------------------------------------------------------------------------
# Kata sandi akun admin awal  — dipakai HANYA saat db:seed
# -----------------------------------------------------------------------------
# Minimal 12 karakter. Bila dikosongkan, seeder membuat sandi acak dan
# menampilkannya sekali di konsol — catat saat itu, karena tidak bisa dilihat lagi.
# Setelah instalasi, ganti sandi tiap akun lewat menu Akun di dashboard.
ADMIN_SEED_PASSWORD=<<< RAHASIA >>>

# -----------------------------------------------------------------------------
# Sesi, cache, antrean
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# WAJIB true bila situs sudah HTTPS: cookie sesi hanya dikirim lewat HTTPS,
# sehingga pencuri sesi di jaringan Wi-Fi publik tidak bisa membajak login admin.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Penyimpanan berkas
# -----------------------------------------------------------------------------
# Dokumen warga (KTP/KK/foto usaha) HARUS di disk privat — jangan "public".
#
#   DOKUMEN_DISK=local  -> storage/app/private di server (default)
#   DOKUMEN_DISK=s3     -> bucket privat Supabase Storage / S3
#
# Untuk Supabase Storage, buat bucket PRIVAT (mis. "dokumen-warga"), lalu isi:
#   AWS_ACCESS_KEY_ID     = S3 access key dari Supabase (bukan anon/service key)
#   AWS_SECRET_ACCESS_KEY = S3 secret key
#   AWS_DEFAULT_REGION    = region project, mis. ap-southeast-1
#   AWS_BUCKET            = dokumen-warga
#   AWS_ENDPOINT          = https://<project-ref>.supabase.co/storage/v1/s3
#   AWS_USE_PATH_STYLE_ENDPOINT=true
#
# Aplikasi selalu membuka berkas lewat rute admin yang memerlukan login dan
# mencatat akses ke log. Bucket tidak pernah dijadikan publik.
FILESYSTEM_DISK=local
DOKUMEN_DISK=local

# Catatan: foto perangkat desa memakai disk "public" secara terpisah di dalam
# kode (folder storage/app/public/perangkat), karena memang untuk ditampilkan
# di halaman Profil. Jalankan "php artisan storage:link" sekali saat deploy.

# -----------------------------------------------------------------------------
# Email  — MAIL_MAILER=log berarti email TIDAK pernah terkirim
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=<<< ISI >>>            # contoh: smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<<< ISI >>>
MAIL_PASSWORD=<<< RAHASIA >>>
MAIL_FROM_ADDRESS="noreply@karangsari.desa.id"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Identitas desa  — hanya nilai AWAL saat seeding
# -----------------------------------------------------------------------------
# Setelah instalasi, ubah lewat menu "Profil & Kontak" di dashboard admin.
# Nilai di sini tidak lagi berpengaruh pada isi situs.
DESA_NAMA="Desa KarangSari"
DESA_KECAMATAN=<<< ISI >>>
DESA_KABUPATEN=<<< ISI >>>
DESA_PROVINSI=<<< ISI >>>
DESA_TAHUN_BERDIRI=<<< ISI >>>

# Awalan nomor referensi pengajuan, mis. KRS -> KRS-2026-0001.
# Pilih 2-4 huruf yang belum dipakai desa lain, lalu JANGAN diubah lagi
# setelah ada pengajuan masuk (nomor lama akan terlihat berbeda polanya).
DESA_PREFIX_REFERENSI=KRS

# Awalan kode surat pada pratinjau, mis. DS-KRS/____/DS-KRS/2026.
DESA_KODE_SURAT=DS-KRS

# -----------------------------------------------------------------------------
# Lain-lain
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
