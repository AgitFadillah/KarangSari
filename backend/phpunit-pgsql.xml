<?xml version="1.0" encoding="UTF-8"?>
<!--
    =========================================================================
    Konfigurasi pengujian untuk PostgreSQL
    =========================================================================
    Produksi memakai PostgreSQL, sedangkan `phpunit.xml` memakai SQLite
    in-memory (cepat, tetapi menyembunyikan banyak bug nyata):

      * PostgreSQL menolak tanggal/angka yang tidak sah dengan
        "invalid input syntax" sehingga berujung HTTP 500, sedangkan SQLite
        diam-diam menerimanya.
      * LIKE pada PostgreSQL bersifat case-sensitive, SQLite tidak.
      * Kolom bigint tidak menerima string kosong (''), SQLite menerima.

    Karena itu seluruh perbaikan diverifikasi ulang dengan berkas ini:

        php artisan test (dengan opsi konfigurasi phpunit-pgsql.xml)

    Nilai koneksi dapat ditimpa variabel lingkungan agar tidak ada kata sandi
    yang tersimpan di repositori. Contoh:

        DB_HOST=127.0.0.1  DB_PORT=5432
        DB_DATABASE=karangsari_test  DB_USERNAME=postgres
        DB_PASSWORD=rahasia

    PERINGATAN: RefreshDatabase mengosongkan basis data yang dipakai.
    Arahkan ke basis data khusus pengujian, JANGAN ke basis data produksi.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="karangsari_test"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
